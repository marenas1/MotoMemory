# Dependencies and build output
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
next-env.d.ts

# Local environment files, including templates and credentials.
.env*
!.env.example

# Private owner acceptance artifacts. Keep the real manual and its results
# outside the repository even when running local OCR acceptance.
local-acceptance/
*.pdf

# Local agent/tooling state.
.agents/
.codex/

# Supabase local configuration is kept local, but versioned migrations are
# part of the application source of truth.
supabase/*
!supabase/
!supabase/migrations/
!supabase/migrations/*.sql
.supabase/

# Logs and operating-system files
*.log
.DS_Store
