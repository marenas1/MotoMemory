# Server-only PostgreSQL connection string for the private Supabase project.
# Leave blank until the project is created manually; never commit the real value.
DATABASE_URL=

# Non-secret project identifier used for private Supabase Storage access.
# Example shape: https://your-project-ref.supabase.co
SUPABASE_PROJECT_URL=

# Server-only Supabase service-role credential for the private manual bucket.
# Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket created by 004_phase2_manual_schema.sql.
SUPABASE_STORAGE_BUCKET=manuals

# Runtime write boundary. Use owner only for the local editing process.
# Production always resolves to readonly, even if this is misconfigured.
MOTOMEMORY_RUNTIME_MODE=owner

# Public abuse controls. The production proxy must overwrite this header with
# exactly one normalized client address before forwarding the request.
MOTOMEMORY_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
MOTOMEMORY_PUBLIC_SEARCH_PER_MINUTE=60
MOTOMEMORY_PUBLIC_QUESTION_PER_MINUTE=10
MOTOMEMORY_PUBLIC_PDF_PER_MINUTE=120
MOTOMEMORY_PUBLIC_THROTTLE_SECONDS=300
MOTOMEMORY_PUBLIC_THROTTLE_AFTER_VIOLATIONS=3

# Optional canonical origin for production CSRF checks.
MOTOMEMORY_APP_ORIGIN=

# Non-production only. Never use deterministic client IP mode in production.
MOTOMEMORY_CLIENT_IP_MODE=deterministic
MOTOMEMORY_TEST_CLIENT_IP=198.51.100.1

# Server-only answer-provider selector. Phase 6 defaults to a fail-closed
# unavailable provider until a production model and credential boundary are
# selected and evaluated.
MOTOMEMORY_ANSWER_PROVIDER=unavailable
